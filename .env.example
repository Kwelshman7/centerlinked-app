VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Super admin bootstrap is configured in Supabase via bootstrap_admin_emails
# (see supabase/bootstrap-super-admin.sql). Do not expose allowlist emails in VITE_ vars.

# Supabase Auth Hook — Before User Created (blocks personal emails server-side)
# Dashboard → Authentication → Hooks → Before User Created → HTTPS endpoint:
#   https://www.centerlinked.com/api/auth-before-user-created
# Paste the generated secret here (v1,whsec_...):
# BEFORE_USER_CREATED_HOOK_SECRET=v1,whsec_...
# Also apply: supabase/approved-personal-emails.sql

# Facility image pipeline (server/facility-images/run-batch.mjs)
# SUPABASE_SERVICE_ROLE=your-service-role-key
# OPENAI_API_KEY=sk-...  # optional but recommended for people-free verification

# Vercel production (Dashboard → Environment Variables):
# SITE_URL=https://www.centerlinked.com

# Transactional email (Resend) — access-request, org welcome, signup + login notices
# Local: add these to your project-root .env (never commit the real key)
# Production: Vercel → Project → Settings → Environment Variables (Production + Preview)
# RESEND_API_KEY=re_...
# ADMIN_NOTIFY_EMAIL=admin@centerlinked.com
# EMAIL_FROM=CenterLinked <Admin@centerlinked.com>
# SITE_URL=https://www.centerlinked.com
# Verify the centerlinked.com domain in Resend so Admin@centerlinked.com can send.

# Scheduled jobs (Vercel Cron) — weekly verification reminder emails
# Vercel sends `Authorization: Bearer $CRON_SECRET` on cron invocations.
# /api/send-verification-reminders refuses to run unless this is set, so it can
# never be triggered anonymously. Generate with: openssl rand -hex 32
# Schedule lives in vercel.json ("crons"). Dry run: append ?dryRun=1.
# CRON_SECRET=...

# Google OAuth (configured in Supabase Dashboard, not in this file):
# 1. Google Cloud Console → OAuth client → Authorized redirect URI:
#    https://your-project-ref.supabase.co/auth/v1/callback
# 2. Supabase → Authentication → Providers → Google → Client ID + Secret
# 3. Supabase → Authentication → URL Configuration:
#    Site URL: http://localhost:8080  (local) or https://www.centerlinked.com (prod)
#    Redirect URLs:
#    http://localhost:8080/auth/callback
#    https://www.centerlinked.com/auth/callback
#    https://centerlinked.com/auth/callback

# ---------------------------------------------------------------------------
# Stripe billing (facility-banded membership + Done For You)
# ---------------------------------------------------------------------------
# Required for checkout / portal / webhooks (server-only — never VITE_ prefix for secrets):
# STRIPE_SECRET_KEY=rk_test_...   # prefer restricted key; sk_test_... also works in test
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MEMBERSHIP=price_...       # Profile $99/month
# STRIPE_PRICE_PROFILE_YEAR=price_...     # Profile $990/year
# STRIPE_PRICE_NETWORK=price_...          # Network $249/month
# STRIPE_PRICE_NETWORK_YEAR=price_...     # Network $2,490/year
# STRIPE_PRICE_GROUP=price_...            # Group $499/month
# STRIPE_PRICE_GROUP_YEAR=price_...       # Group $4,990/year
# STRIPE_PRICE_SETUP=price_...            # DFY 1 facility $499
# STRIPE_PRICE_SETUP_NETWORK=price_...    # DFY 2–5 $1,200
# STRIPE_PRICE_SETUP_GROUP=price_...      # DFY 6–15 $2,500
# SUPABASE_SERVICE_ROLE=...               # webhook + checkout write org billing fields
#
# Dashboard setup (test mode first, then mirror in live):
# 1. Run `node scripts/ensure-stripe-catalog.mjs` or create the same products in Dashboard
# 2. Copy each Price ID into STRIPE_PRICE_* above
# 3. Settings → Billing → Customer portal → enable cancel, payment method, invoices
# 4. Developers → Webhooks → Add endpoint:
#      Local:  stripe listen --forward-to localhost:8080/api/stripe-webhook
#              (paste printed whsec_ into STRIPE_WEBHOOK_SECRET)
#      Prod:   https://www.centerlinked.com/api/stripe-webhook
#    Events: checkout.session.completed, customer.subscription.created,
#            customer.subscription.updated, customer.subscription.deleted,
#            invoice.payment_failed
# 5. Apply SQL: supabase/org-billing.sql
# 6. Vercel → set the same env vars for Production (+ Preview if desired)
# 7. Go-live: switch to live keys/price IDs, recreate webhook with live secret
#
# Optional (not required for hosted Checkout redirect):
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
